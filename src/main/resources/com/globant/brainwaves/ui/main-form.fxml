<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?scenebuilder-preview-i18n-resource Oscilloscope.properties?>

<BorderPane cache="false" prefHeight="660.0" prefWidth="919.0" xmlns="http://javafx.com/javafx/10.0.2-internal" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.globant.brainwaves.ui.MainController">
   <center>
      <AnchorPane prefHeight="105.0" prefWidth="919.0">
      <LineChart fx:id="lineChart" animated="false" layoutX="11.0" layoutY="13.0" mouseTransparent="true" prefHeight="392.0" prefWidth="895.0" title="Spectrum">
         <xAxis>
            <CategoryAxis fx:id="yAxis"  animated="true" autoRanging="true" label="Time (s)"  side="BOTTOM" />
         </xAxis>
         <yAxis>
            <NumberAxis side="LEFT" fx:id="xAxis" animated="true" autoRanging="true" label="BrainWaves" lowerBound="-1000.0" upperBound="1000.0"  />
         </yAxis>
      </LineChart>
      </AnchorPane>
   </center>
   <top>
      <ToolBar prefHeight="0.0" prefWidth="919.0" BorderPane.alignment="CENTER">
        <items>
           <Button fx:id="mainButton" mnemonicParsing="false" onAction="#buttonClicked">
              <graphic>

                 <ImageView fitHeight="32.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                       <Image url="@brainwaves.png" />
                    </image>
                 </ImageView>
              </graphic>
           </Button>
        </items>
      </ToolBar>
   </top>
</BorderPane>
