<?xml version="1.0" encoding="UTF-8"?>

<?scenebuilder-preview-i18n-resource Oscilloscope.properties?>
<?import java.net.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane cache="false" prefHeight="660.0" prefWidth="919.0" stylesheets="application.css"
            xmlns="http://javafx.com/javafx/10.0.2-internal" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.globant.brainwaves.ui.MainController">
    <center>
        <AnchorPane prefHeight="105.0" prefWidth="919.0">
            <LineChart fx:id="lineChart" animated="false" layoutX="11.0" layoutY="13.0" legendSide="BOTTOM"
                       mouseTransparent="false" prefHeight="392.0" prefWidth="895.0" title="Real-Time Analysis">
                <xAxis>
                    <NumberAxis fx:id="yAxis" autoRanging="false" label="Time (s)" lowerBound="1" side="BOTTOM"
                                upperBound="100"/>
                </xAxis>
                <yAxis>
                    <NumberAxis autoRanging="true" label="BrainWaves" lowerBound="-512" minorTickVisible="true"
                                side="LEFT" upperBound="512" fx:id="xAxis"/>
                </yAxis>
            </LineChart>
            <LineChart fx:id="lineChannelChart" animated="false" layoutX="11.0" layoutY="405.0" mouseTransparent="false"
                       prefHeight="392.0" prefWidth="895.0" title="Channel Spectrum">
                <xAxis>
                    <NumberAxis fx:id="yChannelAxis" autoRanging="false" label="Time (s)" lowerBound="1" side="BOTTOM"
                                upperBound="100"/>
                </xAxis>
                <yAxis>
                    <NumberAxis autoRanging="true" label="Neural Spectrum" lowerBound="-512" minorTickVisible="true"
                                side="LEFT" upperBound="512" fx:id="xChannelAxis"/>
                </yAxis>
            </LineChart>
        </AnchorPane>

    </center>
    <top>
        <ToolBar prefHeight="0.0" prefWidth="919.0" BorderPane.alignment="CENTER">
            <items>
                <Button fx:id="mainButton" mnemonicParsing="false" onAction="#buttonClicked">
                    <graphic>

                        <ImageView fitHeight="32.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@brainwaves.png"/>
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
            </items>
        </ToolBar>
    </top>
    <stylesheets>
        <URL value="@application.css"/>
    </stylesheets>
</BorderPane>
